{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jlynneco",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  // The site itself is the static export in ./out (built by `npm run build`).
  // Asset requests are served directly and never invoke the Worker script.
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  // Daily rebuild so new Transformidable CMS items reach the Resources page.
  // 10:00 UTC = early morning US Eastern.
  "triggers": {
    "crons": ["0 10 * * *"]
  },
  "observability": {
    "enabled": true
  },
  // Pull-request builds run `wrangler preview`, which needs this block.
  // Left empty on purpose: previews don't get the cron above, so a preview
  // never fires the production rebuild hook.
  "previews": {}
}
